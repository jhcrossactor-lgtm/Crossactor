# ---- サーバー側シークレット（Supabase Edge Functions の Secrets に送る）----
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
# モデル段階の変更（任意）。未設定なら default=Haiku 4.5、upper=Sonnet 5(low)、max=Fable 5.1(high)
# MODEL_UPPER=claude-opus-5-5
# UPPER_EFFORT=medium
# MODEL_MAX=claude-fable-5-1
# MAX_EFFORT=high
# 合言葉（任意）。設定すると /chat はこの値を知っている画面からしか呼べなくなる
CROSS_ACCESS_KEY=

# ---- フロント側（公開して問題ない値。scripts/deploy.mjs が config.local.js に書き出す）----
# Supabase ダッシュボード → Project Settings → API Keys →「Publishable and secret API keys」タブ
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

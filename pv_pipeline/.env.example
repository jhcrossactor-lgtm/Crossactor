# リポジトリ直下か pv_pipeline/ 直下、または projects/<物件>/ 直下に .env として置く
# ChatGPT Image（画像合成）。auth: proxy を使うときはこちらは不要
OPENAI_API_KEY=
# 動画生成。Google AI Studio (https://aistudio.google.com/apikey) で発行したキー。
# Vertex AI (Google Cloud) のものではない。動画生成は課金の有効化が要ることが多い。
GEMINI_API_KEY=
# 動画生成を MiniMax に切り替えるときだけ。
# 国際版は https://platform.minimax.io/ で発行（中国本土版 minimaxi.com とは別物）。
MINIMAX_API_KEY=
# MiniMax でグループIDが要るアカウントのみ
MINIMAX_GROUP_ID=
